# Slack (operations) — webhook OR bot token + channel
SLACK_WEBHOOK_URL=
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=
SLACK_MAIL_DELIVERY_ALERTS=true
# Optional comma-separated mailable classes for transport-level Slack alerts (empty = off)
# SLACK_MAIL_DELIVERY_ALERT_MAILABLES=

# Per-action Slack channels (channel id like C0123456789, channel name like #lpa, or a dedicated webhook URL per action)
# Use a different channel id (or different incoming webhook URL) for each key so alerts stay separated.
# When a key is left blank, that action uses SLACK_BOT_USER_DEFAULT_CHANNEL first, then SLACK_WEBHOOK_URL (so one webhook is not used for every action).
# Private channels: invite your Slack app/bot into each channel (/invite @YourBot) or Slack returns not_in_channel.
# Copy each id from the Slack desktop URL (…/client/T…/C…). B vs 8 and L vs 1 look alike—paste carefully.
# If the bot is not in the channel: use /invite @YourBot, or add OAuth scope chat:write.public to post to public channels without joining.
SLACK_CHANNEL_LPA=
SLACK_CHANNEL_WILL=
SLACK_CHANNEL_CONTACT=
SLACK_CHANNEL_PAYMENT=

# Mirror every operations Slack notification to this email as well
SLACK_NOTIFICATIONS_MIRROR_EMAIL=d22509384@gmail.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
